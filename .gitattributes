# ---------------- Linguist hints (GitHub language stats) ---------------------
# Keep dbt_packages / dbt target out of language stats and reviews
**/dbt_packages/**  linguist-vendored
**/target/**        linguist-generated
**/.terraform/**    linguist-vendored

# Pin language for Jinja-SQL files (DCM macros)
*.sql        linguist-language=SQL
