# =============================================================================
# Git attributes — force LF for text files so Windows checkouts don't break
# Linux containers, CI runners, snow CLI scripts, etc.
# =============================================================================
# Default: auto-detect text files; if text, store + check out with LF.
# Binary files are left alone (no diff, no line-ending conversion).
# Windows-only formats (.bat / .cmd / .ps1) get CRLF where the tooling needs it.
#
# After changing this file, re-normalize tracked files once:
#   git add --renormalize .
#   git commit -m "normalize line endings per .gitattributes"
# =============================================================================

* text=auto eol=lf

# ---------------- Source / config (LF) ---------------------------------------
*.sh         text eol=lf
*.bash       text eol=lf
*.zsh        text eol=lf
*.py         text eol=lf
*.pyi        text eol=lf
*.ipynb      text eol=lf
*.sql        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.jsonl      text eol=lf
*.toml       text eol=lf
*.ini        text eol=lf
*.cfg        text eol=lf
*.conf       text eol=lf
*.env        text eol=lf
*.tf         text eol=lf
*.tfvars     text eol=lf
*.hcl        text eol=lf
*.md         text eol=lf
*.markdown   text eol=lf
*.rst        text eol=lf
*.txt        text eol=lf
*.csv        text eol=lf
*.tsv        text eol=lf
*.xml        text eol=lf
*.html       text eol=lf
*.htm        text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.js         text eol=lf
*.mjs        text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.jsx        text eol=lf
*.go         text eol=lf
*.java       text eol=lf
*.scala      text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# ---------------- Windows-only (CRLF) ----------------------------------------
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.psd1       text eol=crlf

# ---------------- Binary (no conversion, no diff) ----------------------------
