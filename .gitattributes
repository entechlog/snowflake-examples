*.jpg        binary
*.jpeg       binary
*.gif        binary
*.bmp        binary
*.tiff       binary
*.ico        binary
*.webp       binary
*.svg        binary

# Archives
*.zip        binary
*.gz         binary
*.tar        binary
*.tgz        binary
*.bz2        binary
*.7z         binary
*.rar        binary

# Compiled artifacts
*.exe        binary
*.dll        binary
*.so         binary
*.dylib      binary
*.class      binary
*.jar        binary
*.war        binary
*.ear        binary
*.pyc        binary
*.pyo        binary
*.o          binary
*.a          binary

# Data / columnar formats
